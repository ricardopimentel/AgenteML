{
  "manifest_version": 3,
  "name": "AgenteML Helper",
  "version": "1.0.0",
  "description": "Gere anúncios de afiliados com IA no painel AgenteML a partir do seu navegador.",
  "permissions": [
    "clipboardRead",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.mercadolivre.com.br/*",
    "*://*.mercadolibre.com/*",
    "*://*.meli.la/*",
    "*://*.shopee.com.br/*",
    "*://*.shope.ee/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
